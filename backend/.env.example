# Required: Supabase project settings (never expose the service role key in VITE_* variables)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional AI. Google AI Studio documents an OpenAI-compatible endpoint and a free tier;
# check current quotas/privacy terms before sending any real applicant financial data.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# Leave ML_SERVICE_URL unset unless you deploy a separate Python/FastAPI /predict service.
# ML_SERVICE_URL=https://YOUR-ML-SERVICE.onrender.com

# Comma-separate allowed browser origins. Update to your Vercel URL after deployment.
FRONTEND_URL=http://localhost:5173
PORT=8080

# Optional future billing keys; payments are not enabled until provider checkout/webhooks are implemented.
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
